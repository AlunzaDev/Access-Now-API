APP_ENV=dev
PROD=false
HOST=0.0.0.0
PORT=3000
PUBLIC_PATH=public

# PostgreSQL (`docker compose up -d postgres` publishes it on 127.0.0.1:5435)
DATABASE_URL=postgresql://accessnow:accessnow-dev-password@127.0.0.1:5435/access_now
DATABASE_POOL_MAX=10

JWT_SEED=replace-with-a-long-random-secret
# Clave estable para recuperar QR, distinta de JWT_SEED (obligatoria en producción, 32+ caracteres).
# No la cambies o los QR emitidos deberán reemitirse.
TICKET_QR_ENCRYPTION_KEY=replace-with-another-long-random-secret
# Proteccion contra fuerza bruta en login: solo cuentan los intentos fallidos.
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=20
# Detras de un proxy (nginx, load balancer): numero de saltos de confianza, p. ej. 1.
TRUST_PROXY=false

# URL publica de esta API (enlaces en correos) y del dashboard.
WEB_SERVICE_URL=http://localhost:3000
WEB_CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAILER_EMAIL=
MAILER_SECRET_KEY=
MAILER_SERVICE=
MAILER_HOST=
MAILER_PORT=465
MAILER_SECURE=true
MAILER_FROM_NAME=Access Now

# DigitalOcean Spaces. Si faltan valores requeridos, se usa public/uploads.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=
SPACES_ENDPOINT=
SPACES_CDN_URL=

# Seed (`npm run db:seed`): super administrador inicial. Sin password se genera una y se muestra una vez.
SEED_ADMIN_EMAIL=admin@accessnow.local
SEED_ADMIN_PASSWORD=

# Gateways (SCAT): la Raspberry manda heartbeat cada DEVICE_HEARTBEAT_INTERVAL_MS (se le indica en cada respuesta);
# sin heartbeat por DEVICE_OFFLINE_AFTER_MS (3 perdidos) se muestra fuera de línea; el monitor revisa cada DEVICE_PRESENCE_CHECK_MS.
DEVICE_HEARTBEAT_INTERVAL_MS=60000
DEVICE_OFFLINE_AFTER_MS=180000
DEVICE_PRESENCE_CHECK_MS=30000
# Cola de comandos: un comando entregado sin resultado se reenvía tras DEVICE_COMMAND_RETRY_MS;
# después de DEVICE_COMMAND_MAX_ATTEMPTS entregas queda en ERROR.
DEVICE_COMMAND_RETRY_MS=300000
DEVICE_COMMAND_MAX_ATTEMPTS=5
