// PostgreSQL schema for Access Now.
// The connection URL lives in prisma.config.ts (Prisma 7 no longer reads it from here).
//
// Conventions (same as VIGGO ADMINISTRATIVO)
// - Model names are code, in English (User, Role); fields are the API/database contract, in
//   Spanish (nombre, correo). Tables and columns are snake_case via @@map/@map
//   (docs/convencion-nombres.md).
// - Primary keys are UUID v7 (time ordered, good index locality), generated by Prisma.
// - Instants are timestamptz; money is numeric(12,2). Datasources convert to the
//   epoch-millisecond numbers the domain and API use.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Dashboard sections a permission profile can open (src/domain/constants/auth/user-modules.ts).
enum UserModule {
  users
  permissionProfiles
  projects
  events
  tickets
  scanners
  orders

  @@map("user_module")
}

enum DeviceType {
  GATEWAY
  TERMINAL

  @@map("tipo_dispositivo")
}

enum DeviceDirection {
  ENTRADA
  SALIDA
  BIDIRECCIONAL

  @@map("sentido_dispositivo")
}

/// What happened to a device; device_eventos is append-only (history).
enum DeviceEventType {
  TOKEN_GENERADO
  ENROLADO
  REENROLADO
  CONECTADO
  DESCONECTADO
  ENROLAMIENTO_VENCIDO
  ERROR

  @@map("tipo_evento_dispositivo")
}

enum DeviceConfigStatus {
  PENDIENTE
  CONFIGURADA
  ERROR

  @@map("estado_configuracion_dispositivo")
}

model Role {
  /// Stable code used by the API, e.g. SUPER_ROLE.
  code        String   @id
  nombre      String
  descripcion String   @default("")
  /// System roles are seeded by migrations and must not be deleted.
  sistema     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("roles")
}

/// Dashboard users. They are created by an administrator (no self sign-up).
model User {
  id                     String    @id @default(uuid(7)) @db.Uuid
  nombre                 String
  apellido               String
  /// Stored lowercase.
  correo                 String    @unique
  telefono               String    @default("")
  /// bcrypt hash.
  password               String
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  rol                    String    @default("ADMIN_ROLE")
  /// Sections the user can open. SUPER_ROLE ignores it and can open everything.
  permissionProfileId    String?   @map("permission_profile_id") @db.Uuid
  img                    String    @default("")
  estado                 Boolean   @default(true)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId            String?   @map("creado_por_id") @db.Uuid
  creadoPorNombre        String    @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId       String?   @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre   String    @default("Sistema") @map("actualizado_por_nombre")

  roleRef           Role               @relation(fields: [rol], references: [code], onDelete: Restrict)
  permissionProfile PermissionProfile? @relation(fields: [permissionProfileId], references: [id], onDelete: Restrict)
  /// Projects the user works in. SUPER_ROLE sees every project and keeps none.
  projects          UserProject[]

  @@index([rol])
  @@index([permissionProfileId])
  @@map("usuarios")
}

model PermissionProfile {
  id          String       @id @default(uuid(7)) @db.Uuid
  nombre      String       @unique
  descripcion String       @default("")
  modules     UserModule[] @default([])
  estado      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String? @map("creado_por_id") @db.Uuid
  creadoPorNombre      String  @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String? @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String  @default("Sistema") @map("actualizado_por_nombre")

  users User[]

  @@map("permission_profiles")
}

/// A venue or client: it owns its events and its SCAT scanners (one Raspberry Pi each).
model Project {
  id          String   @id @default(uuid(7)) @db.Uuid
  nombre      String
  /// Short stable code, unique, uppercase with dashes (e.g. ESTADIO-GDL).
  clave       String   @unique
  descripcion String   @default("")
  direccion   String   @default("")
  ciudad      String   @default("")
  img         String   @default("")
  latitud     Float?
  longitud    Float?
  /// An inactive project is hidden from its admins (SUPER_ROLE still sees it).
  estado      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String? @map("creado_por_id") @db.Uuid
  creadoPorNombre      String  @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String? @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String  @default("Sistema") @map("actualizado_por_nombre")

  users UserProject[]
  devices Device[]

  @@map("proyectos")
}

model Device {
  id                       String             @id @default(uuid(7)) @db.Uuid
  projectId                String             @map("proyecto_id") @db.Uuid
  tipo                     DeviceType
  nombre                   String
  ip                       String
  mac                      String?
  modelo                   String             @default("")
  estado                   Boolean            @default(true)
  gatewayId                String?            @map("gateway_id") @db.Uuid
  carril                   String?
  sentido                  DeviceDirection?
  configEstado             DeviceConfigStatus @default(PENDIENTE) @map("config_estado")
  configError              String             @default("") @map("config_error")
  urlRemota                String             @default("") @map("url_remota")
  version                  String             @default("")
  ultimaConexion           DateTime?          @map("ultima_conexion") @db.Timestamptz(3)
  /// Last known presence, switched by heartbeats and the presence monitor (drives CONECTADO/DESCONECTADO events).
  enLinea                  Boolean            @default(false) @map("en_linea")
  enrollmentTokenHash      String?            @map("enrollment_token_hash")
  enrollmentTokenExpiresAt DateTime?          @map("enrollment_token_expires_at") @db.Timestamptz(3)
  enrollmentDurationDays   Int?               @map("enrollment_duration_days")
  deviceTokenHash          String?            @map("device_token_hash")
  deviceFingerprint        String?            @map("device_fingerprint")
  enrolledAt               DateTime?          @map("enrolled_at") @db.Timestamptz(3)
  enrollmentExpiresAt      DateTime?          @map("enrollment_expires_at") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId              String?            @map("creado_por_id") @db.Uuid
  creadoPorNombre          String             @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId         String?            @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre     String             @default("Sistema") @map("actualizado_por_nombre")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gateway   Device?  @relation("GatewayTerminals", fields: [gatewayId], references: [id], onDelete: Restrict)
  terminals Device[] @relation("GatewayTerminals")
  events    DeviceEvent[]

  @@unique([projectId, mac])
  @@index([projectId, tipo])
  @@index([gatewayId])
  @@map("dispositivos")
}

model UserProject {
  userId    String @map("usuario_id") @db.Uuid
  projectId String @map("proyecto_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("usuario_proyectos")
}

/// Immutable history of a device: only inserts, never updates or deletes (except with the device).
model DeviceEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  deviceId    String          @map("dispositivo_id") @db.Uuid
  tipo        DeviceEventType
  detalle     Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId     String?         @map("actor_id") @db.Uuid
  actorNombre String          @default("Sistema") @map("actor_nombre")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("dispositivo_eventos")
}
