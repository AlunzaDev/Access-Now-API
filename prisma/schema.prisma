// PostgreSQL schema for Access Now.
// The connection URL lives in prisma.config.ts (Prisma 7 no longer reads it from here).
//
// Conventions (same as VIGGO ADMINISTRATIVO)
// - Model names are code, in English (User, Role); fields are the API/database contract, in
//   Spanish (nombre, correo). Tables and columns are snake_case via @@map/@map
//   (docs/convencion-nombres.md).
// - Primary keys are UUID v7 (time ordered, good index locality), generated by Prisma.
// - Instants are timestamptz; money is numeric(12,2). Datasources convert to the
//   epoch-millisecond numbers the domain and API use.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Dashboard sections a permission profile can open (src/domain/constants/auth/user-modules.ts).
enum UserModule {
  users
  permissionProfiles
  projects
  events
  tickets
  scanners
  orders
  /// Not a section: lets the profile see the immutable history of tickets and devices.
  history

  @@map("user_module")
}

enum DeviceType {
  GATEWAY
  TERMINAL

  @@map("tipo_dispositivo")
}

enum DeviceDirection {
  ENTRADA
  SALIDA
  BIDIRECCIONAL

  @@map("sentido_dispositivo")
}

/// What happened to a device; device_eventos is append-only (history).
enum DeviceEventType {
  TOKEN_GENERADO
  ENROLADO
  REENROLADO
  CONECTADO
  DESCONECTADO
  ENROLAMIENTO_VENCIDO
  ERROR
  TERMINAL_DETECTADA
  ALERTA_SEGURIDAD
  REVOCADO

  @@map("tipo_evento_dispositivo")
}

enum DeviceConfigStatus {
  PENDIENTE
  CONFIGURADA
  ERROR
  RETIRADA

  @@map("estado_configuracion_dispositivo")
}

enum DeviceCommandType {
  CONFIGURAR_TERMINAL
  ELIMINAR_TERMINAL
  SINCRONIZAR

  @@map("tipo_comando_dispositivo")
}

enum DeviceCommandStatus {
  PENDIENTE
  ENTREGADO
  APLICADO
  ERROR
  CANCELADO

  @@map("estado_comando_dispositivo")
}

enum TicketSaleStatus {
  DISPONIBLE
  RESERVADO
  VENDIDO
  CANCELADO
  REEMBOLSADO

  @@map("estado_venta_boleto")
}

enum TicketEventType {
  GENERADO
  ASIGNADO
  RESERVADO
  VENDIDO
  REASIGNADO
  VALIDADO
  ACCESO_CONCEDIDO
  ACCESO_RECHAZADO
  CANCELADO
  REEMBOLSADO
  QR_REEMITIDO
  QR_CONSULTADO
  ENVIADO
  ENVIO_FALLIDO

  @@map("tipo_evento_boleto")
}

/// Delivery by email, apart from the sale status: sending a ticket does not sell it.
enum TicketDeliveryStatus {
  NO_ENVIADO
  ENVIADO
  ERROR

  @@map("estado_envio_boleto")
}

model Role {
  /// Stable code used by the API, e.g. SUPER_ROLE.
  code        String   @id
  nombre      String
  descripcion String   @default("")
  /// System roles are seeded by migrations and must not be deleted.
  sistema     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("roles")
}

/// Dashboard users. They are created by an administrator (no self sign-up).
model User {
  id                     String    @id @default(uuid(7)) @db.Uuid
  nombre                 String
  apellido               String
  /// Stored lowercase.
  correo                 String    @unique
  telefono               String    @default("")
  /// bcrypt hash.
  password               String
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  rol                    String    @default("ADMIN_ROLE")
  /// Sections the user can open. SUPER_ROLE ignores it and can open everything.
  permissionProfileId    String?   @map("permission_profile_id") @db.Uuid
  img                    String    @default("")
  estado                 Boolean   @default(true)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId            String?   @map("creado_por_id") @db.Uuid
  creadoPorNombre        String    @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId       String?   @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre   String    @default("Sistema") @map("actualizado_por_nombre")

  roleRef           Role               @relation(fields: [rol], references: [code], onDelete: Restrict)
  permissionProfile PermissionProfile? @relation(fields: [permissionProfileId], references: [id], onDelete: Restrict)
  /// Projects the user works in. SUPER_ROLE sees every project and keeps none.
  projects          UserProject[]

  @@index([rol])
  @@index([permissionProfileId])
  @@map("usuarios")
}

model PermissionProfile {
  id                   String       @id @default(uuid(7)) @db.Uuid
  nombre               String       @unique
  descripcion          String       @default("")
  modules              UserModule[] @default([])
  estado               Boolean      @default(true)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?      @map("creado_por_id") @db.Uuid
  creadoPorNombre      String       @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?      @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String       @default("Sistema") @map("actualizado_por_nombre")

  users User[]

  @@map("permission_profiles")
}

/// A venue or client: it owns its events and its SCAT scanners (one Raspberry Pi each).
model Project {
  id                   String   @id @default(uuid(7)) @db.Uuid
  nombre               String
  /// Short stable code, unique, uppercase with dashes (e.g. ESTADIO-GDL).
  clave                String   @unique
  descripcion          String   @default("")
  direccion            String   @default("")
  ciudad               String   @default("")
  img                  String   @default("")
  latitud              Float?
  longitud             Float?
  /// An inactive project is hidden from its admins (SUPER_ROLE still sees it).
  estado               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre      String   @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?  @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String   @default("Sistema") @map("actualizado_por_nombre")

  users      UserProject[]
  devices    Device[]
  events     Event[]
  tickets    Ticket[]
  venueZones VenueZone[]
  venueDoors VenueDoor[]

  @@map("proyectos")
}

model Event {
  id                   String   @id @default(uuid(7)) @db.Uuid
  projectId            String   @map("proyecto_id") @db.Uuid
  nombre               String
  descripcion          String   @default("")
  img                  String   @default("")
  fechaInicio          DateTime @map("fecha_inicio") @db.Date
  fechaFin             DateTime @map("fecha_fin") @db.Date
  horaInicio           String   @map("hora_inicio")
  horaFin              String   @map("hora_fin")
  capacidad            Int?
  zonaHoraria          String   @default("America/Mexico_City") @map("zona_horaria")
  estado               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre      String   @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?  @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String   @default("Sistema") @map("actualizado_por_nombre")

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  zones   EventZone[]

  @@index([projectId, fechaInicio])
  @@map("eventos")
}

model Ticket {
  id                   String               @id @default(uuid(7)) @db.Uuid
  projectId            String               @map("proyecto_id") @db.Uuid
  eventId              String               @map("evento_id") @db.Uuid
  folio                String               @unique
  estadoVenta          TicketSaleStatus     @default(DISPONIBLE) @map("estado_venta")
  titularNombre        String               @default("") @map("titular_nombre")
  titularCorreo        String               @default("") @map("titular_correo")
  titularTelefono      String               @default("") @map("titular_telefono")
  usadoEn              DateTime?            @map("usado_en") @db.Timestamptz(3)
  canceladoEn          DateTime?            @map("cancelado_en") @db.Timestamptz(3)
  estadoEnvio          TicketDeliveryStatus @default(NO_ENVIADO) @map("estado_envio")
  enviadoEn            DateTime?            @map("enviado_en") @db.Timestamptz(3)
  enviadoA             String               @default("") @map("enviado_a")
  zoneId               String?              @map("zona_id") @db.Uuid
  sectionId            String?              @map("seccion_id") @db.Uuid
  rowId                String?              @map("fila_id") @db.Uuid
  seatId               String?              @map("asiento_id") @db.Uuid
  doorId               String?              @map("puerta_id") @db.Uuid
  zonaNombre           String               @default("") @map("zona_nombre")
  seccionNombre        String               @default("") @map("seccion_nombre")
  filaNombre           String               @default("") @map("fila_nombre")
  asientoNombre        String               @default("") @map("asiento_nombre")
  puertaNombre         String               @default("") @map("puerta_nombre")
  emitidoEn            DateTime             @default(now()) @map("emitido_en") @db.Timestamptz(3)
  vendidoEn            DateTime?            @map("vendido_en") @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?              @map("creado_por_id") @db.Uuid
  creadoPorNombre      String               @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?              @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String               @default("Sistema") @map("actualizado_por_nombre")

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// NoAction: an event with tickets is deactivated, never deleted (its tickets keep their history).
  event       Event              @relation(fields: [eventId], references: [id], onDelete: NoAction)
  credentials TicketCredential[]
  history     TicketEvent[]
  deliveries  TicketDelivery[]
  zone        VenueZone?         @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  section     VenueSection?      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  row         VenueRow?          @relation(fields: [rowId], references: [id], onDelete: Restrict)
  seat        VenueSeat?         @relation(fields: [seatId], references: [id], onDelete: Restrict)
  door        VenueDoor?         @relation(fields: [doorId], references: [id], onDelete: Restrict)

  @@index([projectId, eventId, estadoVenta])
  @@index([eventId, createdAt])
  @@map("boletos")
}

model TicketCredential {
  id              String    @id @default(uuid(7)) @db.Uuid
  ticketId        String    @map("boleto_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  tokenCiphertext String?   @map("token_ciphertext")
  tokenIv         String?   @map("token_iv")
  tokenTag        String?   @map("token_tag")
  emitidoEn       DateTime  @default(now()) @map("emitido_en") @db.Timestamptz(3)
  revocadoEn      DateTime? @map("revocado_en") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, emitidoEn])
  @@map("boleto_credenciales")
}

model TicketEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  ticketId    String          @map("boleto_id") @db.Uuid
  terminalId  String?         @map("terminal_id") @db.Uuid
  tipo        TicketEventType
  detalle     Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId     String?         @map("actor_id") @db.Uuid
  actorNombre String          @default("Sistema") @map("actor_nombre")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("boleto_eventos")
}

model Device {
  id                       String             @id @default(uuid(7)) @db.Uuid
  projectId                String             @map("proyecto_id") @db.Uuid
  tipo                     DeviceType
  nombre                   String
  ip                       String
  mac                      String?
  modelo                   String             @default("")
  estado                   Boolean            @default(true)
  gatewayId                String?            @map("gateway_id") @db.Uuid
  doorId                   String?            @map("puerta_id") @db.Uuid
  sentido                  DeviceDirection?
  configEstado             DeviceConfigStatus @default(PENDIENTE) @map("config_estado")
  configError              String             @default("") @map("config_error")
  urlRemota                String             @default("") @map("url_remota")
  version                  String             @default("")
  ultimaConexion           DateTime?          @map("ultima_conexion") @db.Timestamptz(3)
  /// Last known presence, switched by heartbeats and the presence monitor (drives CONECTADO/DESCONECTADO events).
  enLinea                  Boolean            @default(false) @map("en_linea")
  /// Address the gateway's last heartbeat came from (detects the same token used from two places).
  ultimaIpOrigen           String?            @map("ultima_ip_origen")
  enrollmentTokenHash      String?            @map("enrollment_token_hash")
  enrollmentTokenExpiresAt DateTime?          @map("enrollment_token_expires_at") @db.Timestamptz(3)
  enrollmentDurationDays   Int?               @map("enrollment_duration_days")
  deviceTokenHash          String?            @map("device_token_hash")
  deviceFingerprint        String?            @map("device_fingerprint")
  enrolledAt               DateTime?          @map("enrolled_at") @db.Timestamptz(3)
  enrollmentExpiresAt      DateTime?          @map("enrollment_expires_at") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId              String?            @map("creado_por_id") @db.Uuid
  creadoPorNombre          String             @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId         String?            @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre     String             @default("Sistema") @map("actualizado_por_nombre")

  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gateway          Device?         @relation("GatewayTerminals", fields: [gatewayId], references: [id], onDelete: Restrict)
  terminals        Device[]        @relation("GatewayTerminals")
  door             VenueDoor?      @relation(fields: [doorId], references: [id], onDelete: Restrict)
  events           DeviceEvent[]
  gatewayCommands  DeviceCommand[] @relation("GatewayCommands")
  terminalCommands DeviceCommand[] @relation("TerminalCommands")

  @@unique([projectId, mac])
  @@index([projectId, tipo])
  @@index([gatewayId])
  @@index([doorId])
  @@map("dispositivos")
}

model VenueZone {
  id                   String   @id @default(uuid(7)) @db.Uuid
  projectId            String   @map("proyecto_id") @db.Uuid
  nombre               String
  descripcion          String   @default("")
  estado               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre      String   @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?  @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String   @default("Sistema") @map("actualizado_por_nombre")

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections VenueSection[]
  doors    VenueDoorZone[]
  events   EventZone[]
  tickets  Ticket[]

  @@unique([projectId, nombre])
  @@map("proyecto_zonas")
}

model VenueSection {
  id                   String   @id @default(uuid(7)) @db.Uuid
  zoneId               String   @map("zona_id") @db.Uuid
  nombre               String
  descripcion          String   @default("")
  estado               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre      String   @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?  @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String   @default("Sistema") @map("actualizado_por_nombre")

  zone    VenueZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rows    VenueRow[]
  tickets Ticket[]

  @@unique([zoneId, nombre])
  @@map("proyecto_secciones")
}

model VenueRow {
  id                   String   @id @default(uuid(7)) @db.Uuid
  sectionId            String   @map("seccion_id") @db.Uuid
  nombre               String
  estado               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre      String   @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?  @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String   @default("Sistema") @map("actualizado_por_nombre")

  section VenueSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  seats   VenueSeat[]
  tickets Ticket[]

  @@unique([sectionId, nombre])
  @@map("proyecto_filas")
}

model VenueSeat {
  id                   String   @id @default(uuid(7)) @db.Uuid
  rowId                String   @map("fila_id") @db.Uuid
  nombre               String
  estado               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre      String   @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?  @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String   @default("Sistema") @map("actualizado_por_nombre")

  row     VenueRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([rowId, nombre])
  @@map("proyecto_asientos")
}

model VenueDoor {
  id                   String   @id @default(uuid(7)) @db.Uuid
  projectId            String   @map("proyecto_id") @db.Uuid
  nombre               String
  descripcion          String   @default("")
  estado               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creadoPorId          String?  @map("creado_por_id") @db.Uuid
  creadoPorNombre      String   @default("Sistema") @map("creado_por_nombre")
  actualizadoPorId     String?  @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String   @default("Sistema") @map("actualizado_por_nombre")

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zones     VenueDoorZone[]
  terminals Device[]
  tickets   Ticket[]

  @@unique([projectId, nombre])
  @@map("proyecto_puertas")
}

model VenueDoorZone {
  doorId String @map("puerta_id") @db.Uuid
  zoneId String @map("zona_id") @db.Uuid

  door VenueDoor @relation(fields: [doorId], references: [id], onDelete: Cascade)
  zone VenueZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([doorId, zoneId])
  @@map("proyecto_puerta_zonas")
}

model EventZone {
  eventId   String @map("evento_id") @db.Uuid
  zoneId    String @map("zona_id") @db.Uuid
  capacidad Int?

  event Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zone  VenueZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@id([eventId, zoneId])
  @@map("evento_zonas")
}

model UserProject {
  userId    String @map("usuario_id") @db.Uuid
  projectId String @map("proyecto_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("usuario_proyectos")
}

/// Immutable history of a device: only inserts, never updates or deletes (except with the device).
model DeviceEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  deviceId    String          @map("dispositivo_id") @db.Uuid
  tipo        DeviceEventType
  detalle     Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId     String?         @map("actor_id") @db.Uuid
  actorNombre String          @default("Sistema") @map("actor_nombre")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("dispositivo_eventos")
}

/// Order for a gateway, delivered in its heartbeat answer (the API never calls the Raspberry).
/// `payload` keeps what was requested even if the terminal is later edited or deleted.
model DeviceCommand {
  id                   String              @id @default(uuid(7)) @db.Uuid
  gatewayId            String              @map("gateway_id") @db.Uuid
  terminalId           String?             @map("terminal_id") @db.Uuid
  tipo                 DeviceCommandType
  estado               DeviceCommandStatus @default(PENDIENTE)
  payload              Json                @default("{}")
  resultado            Json                @default("{}")
  error                String              @default("")
  intentos             Int                 @default(0)
  entregadoEn          DateTime?           @map("entregado_en") @db.Timestamptz(3)
  finalizadoEn         DateTime?           @map("finalizado_en") @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  creadoPorId          String?             @map("creado_por_id") @db.Uuid
  creadoPorNombre      String              @default("Sistema") @map("creado_por_nombre")
  /// Last change: the user who cancelled it, or the gateway that reported its result.
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  actualizadoPorId     String?             @map("actualizado_por_id") @db.Uuid
  actualizadoPorNombre String              @default("Sistema") @map("actualizado_por_nombre")

  gateway  Device  @relation("GatewayCommands", fields: [gatewayId], references: [id], onDelete: Cascade)
  terminal Device? @relation("TerminalCommands", fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([gatewayId, estado, createdAt])
  @@index([terminalId, createdAt])
  @@map("dispositivo_comandos")
}

/// Every attempt to email a ticket (to whom, result and who sent it). Only ever inserted.
model TicketDelivery {
  id          String               @id @default(uuid(7)) @db.Uuid
  ticketId    String               @map("boleto_id") @db.Uuid
  correo      String
  estado      TicketDeliveryStatus
  error       String               @default("")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId     String?              @map("actor_id") @db.Uuid
  actorNombre String               @default("Sistema") @map("actor_nombre")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("boleto_envios")
}
