# Copiar a .env.docker para `docker compose up`. DATABASE_URL lo arma docker-compose.yml.
JWT_SEED=replace-with-at-least-32-random-characters-xxxx
TRUST_PROXY=1
WEB_SERVICE_URL=https://api.accessnow.example
WEB_CLIENT_URL=https://app.accessnow.example
CORS_ALLOWED_ORIGINS=https://app.accessnow.example
MAILER_EMAIL=
MAILER_SECRET_KEY=
MAILER_HOST=
MAILER_PORT=465
MAILER_SECURE=true
MAILER_FROM_NAME=Access Now
